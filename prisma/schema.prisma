generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserData {
  id               BigInt                    @id @default(autoincrement())
  session_key      String                    @db.Uuid
  latitude         Decimal?                  @db.Decimal(10, 7)
  longitude        Decimal?                  @db.Decimal(10, 7)
  location         Unsupported("geography")?
  datetime         DateTime?
  fingerprintSha   String?                   @db.Char(16)
  browser_language String?
  page_language    String?
  timezone         String?
  email            String?
  ward             String?
  mandal           String?
  district         String?
  pincode          String?
  state            String?
  device_type      String?
  source           String?
  probability      Decimal?                  @db.Decimal(5, 4)
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @default(now()) @updatedAt

  @@index([session_key])
  @@index([fingerprintSha])
  @@index([email])
  @@index([state])
  @@index([district])
  @@index([pincode])
  @@index([updated_at])
  @@index([location], map: "idx_user_data_location", type: Gist)
}

model CuratedData {
  session_key      String                    @id @db.Uuid
  latitude         Decimal?                  @db.Decimal(10, 7)
  longitude        Decimal?                  @db.Decimal(10, 7)
  location         Unsupported("geography")?
  datetime         DateTime?
  fingerprintSha   String?                   @db.Char(16)
  browser_language String?
  page_language    String?
  timezone         String?
  email            String?
  ward             String?
  mandal           String?
  district         String?
  pincode          String?
  state            String?
  device_type      String?
  source           String?
  probability      Decimal?                  @db.Decimal(5, 4)
  curation_version String?
  curated_at       DateTime                  @default(now())
  updated_at       DateTime                  @default(now()) @updatedAt

  @@index([fingerprintSha])
  @@index([email])
  @@index([state])
  @@index([district])
  @@index([pincode])
  @@index([updated_at])
  @@index([location], map: "idx_curated_location", type: Gist)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model RailwayTrack {
  id              BigInt                  @id @default(autoincrement())
  sourceFeatureId BigInt                  @unique @map("source_feature_id")
  trackGauge      String?                 @map("track_gauge") @db.VarChar(10)
  state           String?                 @db.VarChar(100)
  city            String?                 @db.VarChar(100)
  trackName       String?                 @map("track_name") @db.VarChar(100)
  sourceLength    Float?                  @map("source_length")
  geom            Unsupported("geometry")
  created         DateTime                @default(now()) @db.Timestamptz(6)

  @@index([city], map: "idx_railway_track_city")
  @@index([sourceFeatureId], map: "idx_railway_track_source_feature_id")
  @@index([geom], map: "idx_railway_track_geom", type: Gist)
  @@index([trackGauge], map: "idx_railway_track_track_gauge")
  @@index([state], map: "idx_railway_track_state")
  @@index([trackName], map: "idx_railway_track_track_name")
  @@map("railway_track")
}

model RailwayStation {
  id          BigInt  @id @default(autoincrement())
  stationCode String? @unique @map("station_code")
  stationName String  @map("station_name")

  network                   String?
  operator                  String?
  railwayType               String?                 @map("railway_type")
  publicTransportType       String?                 @map("public_transport_type")
  internetAccess            String?                 @map("internet_access")
  trainAvailable            Boolean                 @default(false) @map("train_available")
  geom                      Unsupported("geometry")
  created                   DateTime                @default(now())
  updated                   DateTime                @default(now()) @updatedAt
  departingConnections      TrainConnection[]       @relation("TrainConnectionFromStation")
  arrivingConnections       TrainConnection[]       @relation("TrainConnectionToStation")
  trainStops                TrainStop[]
  sourceTrainEndpoints      TrainEndpoint[]         @relation("TrainEndpointSourceStation")
  destinationTrainEndpoints TrainEndpoint[]         @relation("TrainEndpointDestinationStation")
  transportHubMapping       RailwayStationHub?

  @@map("railway_station")
}

model Train {
  id              BigInt            @id @default(autoincrement())
  trainNumber     String            @map("train_number") @db.VarChar(20)
  trainName       String            @map("train_name") @db.VarChar(200)
  active          Boolean           @default(true)
  created         DateTime          @default(now())
  updated         DateTime          @default(now()) @updatedAt
  ownerCode       String?           @map("owner_code") @db.VarChar(20)
  routeNumber     String            @default("1") @map("route_number") @db.VarChar(20)
  runsMask        Int               @default(127) @map("runs_mask") @db.SmallInt
  sourceUpdatedAt DateTime?         @map("source_updated_at")
  connections     TrainConnection[]
  stops           TrainStop[]
  endpoint        TrainEndpoint?

  @@unique([trainNumber, routeNumber], map: "train_train_number_route_key")
  @@index([active], map: "train_active_idx")
  @@index([active, runsMask], map: "train_active_runs_idx")
  @@map("train")
}

model TrainEndpoint {
  trainId              BigInt   @id @map("train_id")
  sourceStationId      BigInt   @map("source_station_id")
  destinationStationId BigInt   @map("destination_station_id")
  created              DateTime @default(now())
  updated              DateTime @default(now()) @updatedAt

  train              Train          @relation(fields: [trainId], references: [id], onDelete: Cascade)
  sourceStation      RailwayStation @relation("TrainEndpointSourceStation", fields: [sourceStationId], references: [id], onDelete: Restrict)
  destinationStation RailwayStation @relation("TrainEndpointDestinationStation", fields: [destinationStationId], references: [id], onDelete: Restrict)

  @@index([sourceStationId, trainId], map: "train_endpoints_source_station_id_idx")
  @@index([destinationStationId, trainId], map: "train_endpoints_destination_station_id_idx")
  @@map("train_endpoints")
}

model TrainStop {
  id                  BigInt            @id @default(autoincrement())
  trainId             BigInt            @map("train_id")
  stationId           BigInt            @map("station_id")
  sequence            Int
  arrivalTime         DateTime?         @map("arrival_time") @db.Time(0)
  departureTime       DateTime?         @map("departure_time") @db.Time(0)
  dayOffset           Int               @default(0) @map("day_offset")
  created             DateTime          @default(now())
  updated             DateTime          @default(now()) @updatedAt
  arrivalMinute       Int?              @map("arrival_minute")
  departureMinute     Int?              @map("departure_minute")
  distanceKm          Decimal?          @map("distance_km") @db.Decimal(10, 2)
  haltMinutes         Int?              @map("halt_minutes")
  boardingAllowed     Boolean           @default(true) @map("boarding_allowed")
  alightingAllowed    Boolean           @default(true) @map("alighting_allowed")
  outgoingConnections TrainConnection[] @relation("TrainConnectionFromStop")
  incomingConnections TrainConnection[] @relation("TrainConnectionToStop")
  station             RailwayStation    @relation(fields: [stationId], references: [id])
  train               Train             @relation(fields: [trainId], references: [id], onDelete: Cascade)

  @@unique([trainId, sequence], map: "train_stops_train_sequence_key")
  @@index([stationId, sequence], map: "train_stops_station_sequence_idx")
  @@index([stationId, trainId, sequence], map: "train_stops_station_train_sequence_idx")
  @@index([trainId, stationId, sequence], map: "train_stops_train_station_sequence_idx")
  @@map("train_stops")
}

model TrainConnection {
  id              BigInt         @id @default(autoincrement())
  trainId         BigInt         @map("train_id")
  fromStopId      BigInt         @map("from_stop_id")
  toStopId        BigInt         @map("to_stop_id")
  fromStationId   BigInt         @map("from_station_id")
  toStationId     BigInt         @map("to_station_id")
  sequence        Int
  departureMinute Int            @map("departure_minute")
  arrivalMinute   Int            @map("arrival_minute")
  durationMinutes Int            @map("duration_minutes")
  fromStation     RailwayStation @relation("TrainConnectionFromStation", fields: [fromStationId], references: [id])
  fromStop        TrainStop      @relation("TrainConnectionFromStop", fields: [fromStopId], references: [id], onDelete: Cascade)
  toStation       RailwayStation @relation("TrainConnectionToStation", fields: [toStationId], references: [id])
  toStop          TrainStop      @relation("TrainConnectionToStop", fields: [toStopId], references: [id], onDelete: Cascade)
  train           Train          @relation(fields: [trainId], references: [id], onDelete: Cascade)

  @@unique([trainId, sequence], map: "train_connections_train_sequence_key")
  @@index([fromStationId, departureMinute], map: "train_connections_departure_idx")
  @@index([toStationId, arrivalMinute], map: "train_connections_arrival_idx")
  @@map("train_connections")
}

model TrainScheduleImport {
  id              BigInt    @id @default(autoincrement())
  sourceFile      String    @map("source_file")
  checksum        String    @db.Char(64)
  trainNumber     String    @map("train_number") @db.VarChar(20)
  sourceUpdatedAt DateTime? @map("source_updated_at")
  stopCount       Int       @map("stop_count")
  importedAt      DateTime  @default(now()) @map("imported_at")
  routeNumber     String    @default("1") @map("route_number") @db.VarChar(20)

  @@unique([sourceFile, routeNumber], map: "train_schedule_imports_source_route_key")
  @@index([checksum])
  @@index([trainNumber])
  @@map("train_schedule_imports")
}

model TransportCity {
  id             BigInt                    @id @default(autoincrement())
  providerCityId BigInt?                   @unique @map("provider_city_id")
  iataCode       String                    @unique @map("iata_code") @db.VarChar(3)
  name           String                    @db.VarChar(150)
  countryCode    String                    @default("IN") @map("country_code") @db.Char(2)
  latitude       Decimal                   @db.Decimal(10, 7)
  longitude      Decimal                   @db.Decimal(10, 7)
  timezone       String                    @default("Asia/Kolkata") @db.VarChar(100)
  geom           Unsupported("geography")?
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @default(now()) @updatedAt @map("updated_at")
  hubs           TransportHub[]

  @@index([geom], map: "transport_cities_geom_idx", type: Gist)
  @@map("transport_cities")
}

model TransportHub {
  id                    BigInt                    @id @default(autoincrement())
  cityId                BigInt?                   @map("city_id")
  hubType               String                    @map("hub_type") @db.VarChar(20)
  code                  String                    @db.VarChar(20)
  name                  String                    @db.VarChar(200)
  latitude              Decimal                   @db.Decimal(10, 7)
  longitude             Decimal                   @db.Decimal(10, 7)
  timezone              String                    @default("Asia/Kolkata") @db.VarChar(100)
  geom                  Unsupported("geography")?
  active                Boolean                   @default(true)
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @default(now()) @updatedAt @map("updated_at")
  city                  TransportCity?            @relation(fields: [cityId], references: [id], onDelete: SetNull)
  railwayStationMapping RailwayStationHub?
  airport               AviationAirport?
  outgoingTransferLinks HubTransferLink[]         @relation("HubTransferFrom")
  incomingTransferLinks HubTransferLink[]         @relation("HubTransferTo")

  @@unique([hubType, code], map: "transport_hubs_type_code_key")
  @@index([cityId, hubType, active], map: "transport_hubs_city_type_active_idx")
  @@index([geom], map: "transport_hubs_geom_idx", type: Gist)
  @@map("transport_hubs")
}

model RailwayStationHub {
  stationId     BigInt         @id @map("station_id")
  hubId         BigInt         @unique @map("hub_id")
  mappingMethod String         @default("RAILWAY_BACKFILL") @map("mapping_method") @db.VarChar(40)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  station       RailwayStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  hub           TransportHub   @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@map("railway_station_hubs")
}

model AviationAirport {
  id                BigInt                     @id @default(autoincrement())
  providerAirportId BigInt                     @unique @map("provider_airport_id")
  hubId             BigInt                     @unique @map("hub_id")
  iataCode          String                     @unique @map("iata_code") @db.VarChar(3)
  icaoCode          String?                    @map("icao_code") @db.VarChar(4)
  cityIataCode      String?                    @map("city_iata_code") @db.VarChar(3)
  countryCode       String                     @default("IN") @map("country_code") @db.Char(2)
  geonameId         BigInt?                    @map("geoname_id")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @default(now()) @updatedAt @map("updated_at")
  hub               TransportHub               @relation(fields: [hubId], references: [id], onDelete: Cascade)
  departingFlights  AviationFlightInstance[]   @relation("FlightDepartureAirport")
  arrivingFlights   AviationFlightInstance[]   @relation("FlightArrivalAirport")
  coverage          AviationScheduleCoverage[]

  @@index([countryCode, iataCode], map: "aviation_airports_country_iata_idx")
  @@map("aviation_airports")
}

model AviationAirline {
  id                BigInt                   @id @default(autoincrement())
  providerAirlineId BigInt                   @unique @map("provider_airline_id")
  iataCode          String?                  @map("iata_code") @db.VarChar(3)
  icaoCode          String?                  @map("icao_code") @db.VarChar(4)
  name              String                   @db.VarChar(200)
  callsign          String?                  @db.VarChar(100)
  countryCode       String                   @default("IN") @map("country_code") @db.Char(2)
  providerStatus    String?                  @map("provider_status") @db.VarChar(30)
  serviceType       String?                  @map("service_type") @db.VarChar(30)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at")
  flights           AviationFlightInstance[]

  @@index([iataCode], map: "aviation_airlines_iata_idx")
  @@index([icaoCode], map: "aviation_airlines_icao_idx")
  @@map("aviation_airlines")
}

model AviationScheduleImport {
  id                 BigInt   @id @default(autoincrement())
  sourceFile         String   @map("source_file")
  checksum           String   @db.Char(64)
  sourceAirportCode  String   @map("source_airport_code") @db.VarChar(3)
  serviceDate        DateTime @map("service_date") @db.Date
  status             String   @db.VarChar(30)
  totalRows          Int      @default(0) @map("total_rows")
  acceptedRows       Int      @default(0) @map("accepted_rows")
  codeshareRows      Int      @default(0) @map("codeshare_rows")
  internationalRows  Int      @default(0) @map("international_rows")
  unknownAirportRows Int      @default(0) @map("unknown_airport_rows")
  invalidRows        Int      @default(0) @map("invalid_rows")
  importedAt         DateTime @default(now()) @map("imported_at")

  @@unique([sourceAirportCode, serviceDate, checksum], map: "aviation_schedule_imports_file_key")
  @@index([serviceDate, status], map: "aviation_schedule_imports_date_status_idx")
  @@map("aviation_schedule_imports")
}

model AviationScheduleCoverage {
  id          BigInt          @id @default(autoincrement())
  airportId   BigInt          @map("airport_id")
  serviceDate DateTime        @map("service_date") @db.Date
  status      String          @db.VarChar(30)
  detail      String?
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")
  airport     AviationAirport @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@unique([airportId, serviceDate], map: "aviation_schedule_coverage_airport_date_key")
  @@index([serviceDate, status], map: "aviation_schedule_coverage_date_status_idx")
  @@map("aviation_schedule_coverage")
}

model AviationFlightInstance {
  id                 BigInt           @id @default(autoincrement())
  identityKey        String           @unique @map("identity_key") @db.VarChar(160)
  airlineId          BigInt?          @map("airline_id")
  departureAirportId BigInt           @map("departure_airport_id")
  arrivalAirportId   BigInt           @map("arrival_airport_id")
  serviceDate        DateTime         @map("service_date") @db.Date
  airlineIataCode    String?          @map("airline_iata_code") @db.VarChar(3)
  airlineIcaoCode    String?          @map("airline_icao_code") @db.VarChar(4)
  flightNumber       String           @map("flight_number") @db.VarChar(16)
  flightIataNumber   String?          @map("flight_iata_number") @db.VarChar(16)
  flightIcaoNumber   String?          @map("flight_icao_number") @db.VarChar(20)
  departureAt        DateTime         @map("departure_at") @db.Timestamptz(6)
  arrivalAt          DateTime         @map("arrival_at") @db.Timestamptz(6)
  departureTerminal  String?          @map("departure_terminal") @db.VarChar(10)
  arrivalTerminal    String?          @map("arrival_terminal") @db.VarChar(10)
  departureGate      String?          @map("departure_gate") @db.VarChar(10)
  arrivalGate        String?          @map("arrival_gate") @db.VarChar(10)
  aircraftModelCode  String?          @map("aircraft_model_code") @db.VarChar(20)
  aircraftModelText  String?          @map("aircraft_model_text") @db.VarChar(100)
  status             String?          @db.VarChar(30)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")
  airline            AviationAirline? @relation(fields: [airlineId], references: [id], onDelete: SetNull)
  departureAirport   AviationAirport  @relation("FlightDepartureAirport", fields: [departureAirportId], references: [id], onDelete: Restrict)
  arrivalAirport     AviationAirport  @relation("FlightArrivalAirport", fields: [arrivalAirportId], references: [id], onDelete: Restrict)

  @@index([departureAirportId, departureAt, active], map: "aviation_flights_departure_lookup_idx")
  @@index([arrivalAirportId, arrivalAt, active], map: "aviation_flights_arrival_lookup_idx")
  @@index([serviceDate, active], map: "aviation_flights_service_date_idx")
  @@map("aviation_flight_instances")
}

model HubTransferLink {
  id                      BigInt       @id @default(autoincrement())
  fromHubId               BigInt       @map("from_hub_id")
  toHubId                 BigInt       @map("to_hub_id")
  aerialDistanceKm        Decimal      @map("aerial_distance_km") @db.Decimal(10, 2)
  estimatedRoadDistanceKm Decimal      @map("estimated_road_distance_km") @db.Decimal(10, 2)
  travelMinutes           Int          @map("travel_minutes")
  averageSpeedKph         Decimal      @map("average_speed_kph") @db.Decimal(6, 2)
  detourFactor            Decimal      @map("detour_factor") @db.Decimal(5, 2)
  method                  String       @default("AERIAL_DISTANCE_DETOUR_FACTOR") @db.VarChar(50)
  active                  Boolean      @default(true)
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at")
  fromHub                 TransportHub @relation("HubTransferFrom", fields: [fromHubId], references: [id], onDelete: Cascade)
  toHub                   TransportHub @relation("HubTransferTo", fields: [toHubId], references: [id], onDelete: Cascade)

  @@unique([fromHubId, toHubId], map: "hub_transfer_links_pair_key")
  @@index([fromHubId, active], map: "hub_transfer_links_from_active_idx")
  @@map("hub_transfer_links")
}

model JourneyRoutingPolicy {
  id                               Int      @id @default(1)
  version                          Int      @default(1)
  active                           Boolean  @default(true)
  roadSpeedKph                     Decimal  @default(30) @map("road_speed_kph") @db.Decimal(6, 2)
  longDistanceRoadSpeedKph         Decimal  @default(60) @map("long_distance_road_speed_kph") @db.Decimal(6, 2)
  roadSpeedDistanceThresholdKm     Decimal  @default(50) @map("road_speed_distance_threshold_km") @db.Decimal(6, 2)
  roadDetourFactor                 Decimal  @default(1.5) @map("road_detour_factor") @db.Decimal(5, 2)
  initialRailBufferMinutes         Int      @default(30) @map("initial_rail_buffer_minutes")
  initialFlightBufferMinutes       Int      @default(30) @map("initial_flight_buffer_minutes")
  railToRailMinutes                Int      @default(10) @map("rail_to_rail_minutes")
  railToFlightBufferMinutes        Int      @default(0) @map("rail_to_flight_buffer_minutes")
  flightToRailExitMinutes          Int      @default(0) @map("flight_to_rail_exit_minutes")
  flightToRailBufferMinutes        Int      @default(0) @map("flight_to_rail_buffer_minutes")
  sameAirportFlightTransferMinutes Int      @default(30) @map("same_airport_flight_transfer_minutes")
  maximumTransfers                 Int      @default(3) @map("maximum_transfers")
  searchHorizonDays                Int      @default(3) @map("search_horizon_days")
  updatedAt                        DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("journey_routing_policies")
}
