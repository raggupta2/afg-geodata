generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserData {
  id               BigInt                    @id @default(autoincrement())
  session_key      String                    @db.Uuid
  latitude         Decimal?                  @db.Decimal(10, 7)
  longitude        Decimal?                  @db.Decimal(10, 7)
  location         Unsupported("geography")?
  datetime         DateTime?
  fingerprintSha   String?                   @db.Char(16)
  browser_language String?
  page_language    String?
  timezone         String?
  email            String?
  ward             String?
  mandal           String?
  district         String?
  pincode          String?
  state            String?
  device_type      String?
  source           String?
  probability      Decimal?                  @db.Decimal(5, 4)
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @default(now()) @updatedAt

  @@index([session_key])
  @@index([fingerprintSha])
  @@index([email])
  @@index([state])
  @@index([district])
  @@index([pincode])
  @@index([updated_at])
  @@index([location], map: "idx_user_data_location", type: Gist)
}

model CuratedData {
  session_key      String                    @id @db.Uuid
  latitude         Decimal?                  @db.Decimal(10, 7)
  longitude        Decimal?                  @db.Decimal(10, 7)
  location         Unsupported("geography")?
  datetime         DateTime?
  fingerprintSha   String?                   @db.Char(16)
  browser_language String?
  page_language    String?
  timezone         String?
  email            String?
  ward             String?
  mandal           String?
  district         String?
  pincode          String?
  state            String?
  device_type      String?
  source           String?
  probability      Decimal?                  @db.Decimal(5, 4)
  curation_version String?
  curated_at       DateTime                  @default(now())
  updated_at       DateTime                  @default(now()) @updatedAt

  @@index([fingerprintSha])
  @@index([email])
  @@index([state])
  @@index([district])
  @@index([pincode])
  @@index([updated_at])
  @@index([location], map: "idx_curated_location", type: Gist)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model RailwayTrack {
  id              BigInt                  @id @default(autoincrement())
  sourceFeatureId BigInt                  @unique @map("source_feature_id")
  trackGauge      String?                 @map("track_gauge") @db.VarChar(10)
  state           String?                 @db.VarChar(100)
  city            String?                 @db.VarChar(100)
  trackName       String?                 @map("track_name") @db.VarChar(100)
  sourceLength    Float?                  @map("source_length")
  geom            Unsupported("geometry")
  created         DateTime                @default(now()) @db.Timestamptz(6)

  @@index([city], map: "idx_railway_track_city")
  @@index([sourceFeatureId], map: "idx_railway_track_source_feature_id")
  @@index([geom], map: "idx_railway_track_geom", type: Gist)
  @@index([trackGauge], map: "idx_railway_track_track_gauge")
  @@index([state], map: "idx_railway_track_state")
  @@index([trackName], map: "idx_railway_track_track_name")
  @@map("railway_track")
}

model RailwayStation {
  id          BigInt  @id @default(autoincrement())
  stationCode String? @unique @map("station_code")
  stationName String  @map("station_name")

  network                   String?
  operator                  String?
  railwayType               String?                 @map("railway_type")
  publicTransportType       String?                 @map("public_transport_type")
  internetAccess            String?                 @map("internet_access")
  trainAvailable            Boolean                 @default(false) @map("train_available")
  geom                      Unsupported("geometry")
  created                   DateTime                @default(now())
  updated                   DateTime                @default(now()) @updatedAt
  departingConnections      TrainConnection[]       @relation("TrainConnectionFromStation")
  arrivingConnections       TrainConnection[]       @relation("TrainConnectionToStation")
  trainStops                TrainStop[]
  sourceTrainEndpoints      TrainEndpoint[]         @relation("TrainEndpointSourceStation")
  destinationTrainEndpoints TrainEndpoint[]         @relation("TrainEndpointDestinationStation")

  @@map("railway_station")
}

model Train {
  id              BigInt            @id @default(autoincrement())
  trainNumber     String            @map("train_number") @db.VarChar(20)
  trainName       String            @map("train_name") @db.VarChar(200)
  active          Boolean           @default(true)
  created         DateTime          @default(now())
  updated         DateTime          @default(now()) @updatedAt
  ownerCode       String?           @map("owner_code") @db.VarChar(20)
  routeNumber     String            @default("1") @map("route_number") @db.VarChar(20)
  runsMask        Int               @default(127) @map("runs_mask") @db.SmallInt
  sourceUpdatedAt DateTime?         @map("source_updated_at")
  connections     TrainConnection[]
  stops           TrainStop[]
  endpoint        TrainEndpoint?

  @@unique([trainNumber, routeNumber], map: "train_train_number_route_key")
  @@index([active], map: "train_active_idx")
  @@index([active, runsMask], map: "train_active_runs_idx")
  @@map("train")
}

model TrainEndpoint {
  trainId              BigInt   @id @map("train_id")
  sourceStationId      BigInt   @map("source_station_id")
  destinationStationId BigInt   @map("destination_station_id")
  created              DateTime @default(now())
  updated              DateTime @default(now()) @updatedAt

  train              Train          @relation(fields: [trainId], references: [id], onDelete: Cascade)
  sourceStation      RailwayStation @relation("TrainEndpointSourceStation", fields: [sourceStationId], references: [id], onDelete: Restrict)
  destinationStation RailwayStation @relation("TrainEndpointDestinationStation", fields: [destinationStationId], references: [id], onDelete: Restrict)

  @@index([sourceStationId, trainId], map: "train_endpoints_source_station_id_idx")
  @@index([destinationStationId, trainId], map: "train_endpoints_destination_station_id_idx")
  @@map("train_endpoints")
}

model TrainStop {
  id                  BigInt            @id @default(autoincrement())
  trainId             BigInt            @map("train_id")
  stationId           BigInt            @map("station_id")
  sequence            Int
  arrivalTime         DateTime?         @map("arrival_time") @db.Time(0)
  departureTime       DateTime?         @map("departure_time") @db.Time(0)
  dayOffset           Int               @default(0) @map("day_offset")
  created             DateTime          @default(now())
  updated             DateTime          @default(now()) @updatedAt
  arrivalMinute       Int?              @map("arrival_minute")
  departureMinute     Int?              @map("departure_minute")
  distanceKm          Decimal?          @map("distance_km") @db.Decimal(10, 2)
  haltMinutes         Int?              @map("halt_minutes")
  boardingAllowed     Boolean           @default(true) @map("boarding_allowed")
  alightingAllowed    Boolean           @default(true) @map("alighting_allowed")
  outgoingConnections TrainConnection[] @relation("TrainConnectionFromStop")
  incomingConnections TrainConnection[] @relation("TrainConnectionToStop")
  station             RailwayStation    @relation(fields: [stationId], references: [id])
  train               Train             @relation(fields: [trainId], references: [id], onDelete: Cascade)

  @@unique([trainId, sequence], map: "train_stops_train_sequence_key")
  @@index([stationId, sequence], map: "train_stops_station_sequence_idx")
  @@index([stationId, trainId, sequence], map: "train_stops_station_train_sequence_idx")
  @@index([trainId, stationId, sequence], map: "train_stops_train_station_sequence_idx")
  @@map("train_stops")
}

model TrainConnection {
  id              BigInt         @id @default(autoincrement())
  trainId         BigInt         @map("train_id")
  fromStopId      BigInt         @map("from_stop_id")
  toStopId        BigInt         @map("to_stop_id")
  fromStationId   BigInt         @map("from_station_id")
  toStationId     BigInt         @map("to_station_id")
  sequence        Int
  departureMinute Int            @map("departure_minute")
  arrivalMinute   Int            @map("arrival_minute")
  durationMinutes Int            @map("duration_minutes")
  fromStation     RailwayStation @relation("TrainConnectionFromStation", fields: [fromStationId], references: [id])
  fromStop        TrainStop      @relation("TrainConnectionFromStop", fields: [fromStopId], references: [id], onDelete: Cascade)
  toStation       RailwayStation @relation("TrainConnectionToStation", fields: [toStationId], references: [id])
  toStop          TrainStop      @relation("TrainConnectionToStop", fields: [toStopId], references: [id], onDelete: Cascade)
  train           Train          @relation(fields: [trainId], references: [id], onDelete: Cascade)

  @@unique([trainId, sequence], map: "train_connections_train_sequence_key")
  @@index([fromStationId, departureMinute], map: "train_connections_departure_idx")
  @@index([toStationId, arrivalMinute], map: "train_connections_arrival_idx")
  @@map("train_connections")
}

model TrainScheduleImport {
  id              BigInt    @id @default(autoincrement())
  sourceFile      String    @map("source_file")
  checksum        String    @db.Char(64)
  trainNumber     String    @map("train_number") @db.VarChar(20)
  sourceUpdatedAt DateTime? @map("source_updated_at")
  stopCount       Int       @map("stop_count")
  importedAt      DateTime  @default(now()) @map("imported_at")
  routeNumber     String    @default("1") @map("route_number") @db.VarChar(20)

  @@unique([sourceFile, routeNumber], map: "train_schedule_imports_source_route_key")
  @@index([checksum])
  @@index([trainNumber])
  @@map("train_schedule_imports")
}
