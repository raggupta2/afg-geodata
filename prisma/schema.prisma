generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model UserData {
  id BigInt @id @default(autoincrement())
  session_key String @db.Uuid

  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  location Unsupported("geography(Point,4326)")?
  datetime DateTime?

  fingerprintSha String? @db.Char(16)
  browser_language String?
  page_language String?
  timezone String?
  email String?

  ward String?
  mandal String?
  district String?
  pincode String?
  state String?

  device_type String?
  source String?
  probability Decimal? @db.Decimal(5, 4)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([session_key])
  @@index([fingerprintSha])
  @@index([email])
  @@index([state])
  @@index([district])
  @@index([pincode])
  @@index([updated_at])
  @@index([location], type: Gist, map: "idx_user_data_location")
}

model CuratedData {
  session_key String @id @db.Uuid

  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  location Unsupported("geography(Point,4326)")?

  datetime DateTime?
  fingerprintSha String? @db.Char(16)
  browser_language String?
  page_language String?
  timezone String?
  email String?

  ward String?
  mandal String?
  district String?
  pincode String?
  state String?

  device_type String?
  source String?
  probability Decimal? @db.Decimal(5, 4)

  curation_version String?
  curated_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([fingerprintSha])
  @@index([email])
  @@index([state])
  @@index([district])
  @@index([pincode])
  @@index([updated_at])
  @@index([location], type: Gist, map: "idx_curated_location")
}
